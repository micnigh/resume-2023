{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && touch dist/.nojekyll && echo 'resume.mnigh.com' > dist/CNAME && cp dist/index.html dist/404.html && gh-pages -d dist",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/eslint__js": "^9.14.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "24.5.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "lodash": "^4.17.21",
    "marked": "^16.3.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "tippy.js": "^6.3.7",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.46.0",
    "uuid": "^13.0.0",
    "vite": "^7.1.5"
  },
  "engines": {
    "pnpm": ">=10.15.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
